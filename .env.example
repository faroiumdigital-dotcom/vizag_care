# Copy this file to .env and fill in LLAMA_API_KEY. Never commit .env.
LLAMA_API_KEY=your_groq_key_here
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=openai/gpt-oss-20b
# Optional: tried once if the main model returns 404/413/429 (must be a model your key can access)
LLAMA_FALLBACK_MODEL=

# Comma-separated list of frontend URLs allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# Limits
RATE_LIMIT_PER_MINUTE=30
MAX_MESSAGE_CHARS=500
HISTORY_MESSAGES=4
MAX_OUTPUT_TOKENS=400
SESSION_TTL_MINUTES=60

# Set to true only when running behind a trusted proxy (Render, Railway, nginx)
TRUST_PROXY=false
